.hint { color: var(--ink-2); margin: 24rpx 8rpx; font-size: 26rpx; }
.member .row { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.name { flex: 1; min-width: 100rpx; word-break: break-all; font-size: 30rpx; font-weight: 600; }
.openid { font-size: 24rpx; color: var(--ink-2); word-break: break-all; margin-bottom: 20rpx; }
.actions button { margin: 0; }
.tag { font-size: 22rpx; padding: 4rpx 16rpx; border: var(--line); border-radius: 999rpx; font-weight: 600; }
.tag.ok { background: var(--green-soft); }
.tag.muted { background: var(--pink); }
.muted { color: var(--ink-2); }
.small { font-size: 24rpx; }
