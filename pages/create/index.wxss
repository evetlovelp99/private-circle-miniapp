.textarea {
  width: 100%;
  min-height: 220rpx;
  margin-bottom: 20rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.img {
  width: 30%;
  height: 180rpx;
  border-radius: 8rpx;
}

.voice-block {
  margin-bottom: 20rpx;
}

.record-chip {
  display: inline-block;
  padding: 22rpx 28rpx;
  border-radius: 16rpx;
  background: #111;
  color: #fff;
  font-size: 28rpx;
  max-width: 100%;
}

.record-chip.recording {
  background: #1aad19;
}

.voice-hint {
  margin-top: 16rpx;
  color: #666;
  font-size: 24rpx;
}

.section-tip {
  margin: 20rpx 0 12rpx;
  color: #888;
  font-size: 24rpx;
}

.video-preview {
  margin: 16rpx 0;
}

.preview-video {
  width: 100%;
  max-height: 360rpx;
  border-radius: 8rpx;
  background: #000;
}

.meta {
  margin-top: 8rpx;
  color: #666;
  font-size: 24rpx;
}

.live-row {
  margin: 12rpx 0;
}

.live-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

.live-label {
  display: block;
  margin-top: 8rpx;
  color: #666;
  font-size: 24rpx;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
