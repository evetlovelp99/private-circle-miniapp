.container.publish-page { padding-bottom: 220rpx; padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.publish-hero { text-align: center; background: var(--blue); border: var(--line); border-radius: 120rpx 120rpx 40rpx 40rpx; padding: 40rpx 24rpx 32rpx; margin-bottom: 24rpx; }
.hero-title { color: var(--card); font-size: 40rpx; font-weight: 600; margin-top: 16rpx; }
.hero-note { color: var(--card); font-size: 24rpx; margin-top: 8rpx; }
.textarea { width: 100%; min-height: 260rpx; padding: 24rpx; border: var(--line); border-radius: 36rpx; background: var(--card); font-size: 29rpx; line-height: 1.7; }
.text-placeholder { color: var(--ink-2); }
.image-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.img, .add-image { width: calc((100% - 24rpx) / 3); height: 176rpx; border-radius: 24rpx; }
.add-image { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 4rpx dashed var(--ink); background: var(--blue-light); font-size: 60rpx; }
.section-tip { margin: 28rpx 0 16rpx; color: var(--ink-2); font-size: 24rpx; }
.video-preview { margin: 16rpx 0; }
.preview-video { display: block; width: 100%; height: 320rpx; border: var(--line); border-radius: 24rpx; background: var(--ink); margin-bottom: 12rpx; }
.meta, .live-label, .voice-hint { display: block; color: var(--ink-2); font-size: 24rpx; margin: 12rpx 0; }
.live-row { margin: 16rpx 0; }
.live-cover { width: 184rpx; height: 184rpx; }
.btn-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.btn-row button { margin: 0; }
.voice-block { margin: 28rpx 0; }
.record-chip { text-align: center; padding: 24rpx 16rpx; border: var(--line); border-radius: 999rpx; background: var(--blue-light); font-weight: 600; }
.record-chip.recording { background: var(--pink); }
.publish-submit { display: block; width: 100%; background: var(--orange); color: var(--card); font-size: 32rpx; padding: 24rpx; margin-top: 32rpx; }
