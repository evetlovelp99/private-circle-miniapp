<view class="container" wx:if="{{post}}">
  <view class="card">
    <view class="detail-head">
      <view class="name">{{post.author.nickname || "匿名用户"}}</view>
      <button wx:if="{{canDelete}}" class="danger" size="mini" bindtap="onDelete">删除</button>
    </view>
    <view class="text" wx:if="{{post.text}}">{{post.text}}</view>
    <view class="audio-wrap" wx:if="{{audioUrl}}">
      <audio class="audio" controls="{{true}}" src="{{audioUrl}}" />
    </view>

    <view wx:if="{{hasLive && liveMotionUrl}}" class="video-wrap">
      <video
        class="detail-video"
        src="{{liveMotionUrl}}"
        poster="{{livePosterUrl}}"
        controls
        show-center-play-btn="{{true}}"
        object-fit="contain"
      />
      <view class="badge-live">实况</view>
    </view>

    <view wx:elif="{{showVideoOnly && videoUrl}}" class="video-wrap">
      <video
        class="detail-video"
        src="{{videoUrl}}"
        poster="{{videoPosterUrl}}"
        controls
        show-center-play-btn="{{true}}"
        object-fit="contain"
      />
    </view>

    <view class="image-list" wx:if="{{post.images.length && !hasLive}}">
      <image class="img" wx:for="{{post.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
    </view>
  </view>

  <view class="card">
    <view class="comment-title">评论（{{comments.length}}）</view>
    <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
      <text class="comment-user">{{item.user.nickname || "匿名"}}：</text>
      <text>{{item.content}}</text>
    </view>
    <view class="empty" wx:if="{{!comments.length}}">还没有评论</view>
  </view>

  <view class="card row">
    <input class="input" placeholder="写评论..." value="{{content}}" bindinput="onInput" />
    <button class="btn-primary small-btn" bindtap="submitComment">发送</button>
  </view>
</view>
