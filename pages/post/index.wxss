.detail-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.name { font-size: 30rpx; font-weight: 600; flex: 1; min-width: 0; word-break: break-all; }
.danger { background: var(--pink); margin: 0; }
.text { margin-bottom: 24rpx; white-space: pre-wrap; word-break: break-word; line-height: 1.8; }
.audio-wrap { margin-bottom: 24rpx; }
.audio { width: 100%; }
.video-wrap { position: relative; margin-bottom: 24rpx; border: var(--line); border-radius: 24rpx; overflow: hidden; }
.detail-video { display: block; width: 100%; height: 360rpx; background: var(--ink); }
.badge-live { position: absolute; left: 16rpx; top: 16rpx; background: var(--yellow); border: var(--line); border-radius: 999rpx; font-size: 22rpx; padding: 2rpx 16rpx; }
.image-list { display: flex; flex-direction: column; gap: 16rpx; min-width: 0; }
.img { display: block; width: 100%; max-width: 100%; height: 360rpx; }
.comment-title { margin-bottom: 24rpx; font-size: 32rpx; font-weight: 600; }
.comment-item { margin-bottom: 16rpx; word-break: break-word; }
.comment-user { color: var(--blue-deep); font-weight: 600; }
.row { display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; }
.row .input { flex: 1; min-width: 180rpx; width: auto; }
.small-btn { margin: 0; background: var(--blue); color: var(--card); }
.empty { color: var(--ink-2); }
