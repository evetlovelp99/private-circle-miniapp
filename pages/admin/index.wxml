<view class="container">
  <view class="page-heading"><view class="page-title">打理小圈子</view><view class="page-note">让分享保持亲近。</view></view>
  <view class="card">
    <button bindtap="goMembers">成员管理（邀请进来的人）</button>
  </view>

  <view class="card">
    <view class="title">生成邀请码</view>
    <button class="btn-primary" bindtap="createInviteCode">生成一次性邀请码</button>
    <view class="code" wx:if="{{newCode}}">
      最新邀请码：{{newCode}}
      <button size="mini" bindtap="copyCode">复制</button>
    </view>
  </view>

  <view class="card">
    <view class="title">静默减少可见性</view>
    <input class="input" placeholder="输入对方 openid" value="{{viewerOpenid}}" bindinput="onInputViewer" />
    <button bindtap="silentCutoff">停止他看到你后续新动态</button>
  </view>

</view>
