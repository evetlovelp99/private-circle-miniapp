.container.profile-page { padding-bottom: 220rpx; padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.profile-card { text-align: center; padding-top: 40rpx; background: var(--yellow); }
.profile-name-row { display: flex; align-items: center; justify-content: center; flex-wrap: nowrap; gap: 12rpx; margin-top: 20rpx; }
.profile-name { flex: 0 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 36rpx; font-weight: 600; }
.profile-name-row .rename-pill { display: flex; align-items: center; gap: 8rpx; flex: none; width: auto; white-space: nowrap; margin: 0; padding: 10rpx 20rpx; background: var(--card); border: var(--line); border-radius: 999rpx; font-size: 24rpx; }
.profile-label { margin-top: 24rpx; font-size: 22rpx; color: var(--ink-2); }
.profile-id { font-size: 24rpx; word-break: break-all; margin-top: 8rpx; }
.management-title { font-size: 32rpx; font-weight: 600; }
.management-card button { margin-top: 24rpx; width: 100%; }

.nickname-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000; }
.nickname-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(44, 44, 42, 0.4); }
.nickname-sheet { position: absolute; bottom: 0; left: 0; right: 0; background: var(--card); border-radius: 36rpx 36rpx 0 0; padding: 40rpx 32rpx 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.nickname-title { font-size: 36rpx; font-weight: 600; }
.nickname-hint { font-size: 24rpx; color: var(--ink-2); margin-top: 12rpx; }
.nickname-input { width: 100%; height: 96rpx; padding: 20rpx 28rpx; margin-top: 28rpx; border: var(--line); border-radius: 999rpx; background: var(--card); font-size: 28rpx; }
.nickname-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.nickname-actions button { margin: 0; min-width: 0; }
.nickname-cancel { flex: 1; background: var(--card); }
.nickname-save { flex: 2; background: var(--blue); color: #fff; }
